# ==============================================================================
# CrimeSense Frontend - Environment Configuration Example
# Copy this file to `.env` or `.env.production` in the frontend directory.
# NEVER commit .env or secrets to version control.
# ==============================================================================

# Backend API URL (without /api suffix)
# Local development: http://localhost:5000
# Production: https://your-flask-backend.example.com
VITE_API_URL=http://localhost:5000

# Alternative API base with /api suffix (if preferred)
VITE_API_BASE_URL=http://localhost:5000/api

# Google Identity Services (GIS) Web Application Client ID
# Set to your Google Cloud Console OAuth 2.0 Web Client ID
# Authorized JavaScript origins: http://localhost:5173, https://crime-sense1234.web.app
VITE_GOOGLE_CLIENT_ID=your_actual_google_client_id

# Firebase Cloud Messaging & Alerts Configuration
# Safe for client bundle (public Firebase configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=crime-sense1234.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=crime-sense1234
VITE_FIREBASE_STORAGE_BUCKET=crime-sense1234.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
