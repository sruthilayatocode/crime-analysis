# ============================================================
# CrimeSense backend environment variables (template)
#
# Copy this file to backend/.env and fill in your values.
# backend/.env is git-ignored and must NEVER be committed.
#
# Database:
#   SQLALCHEMY_DATABASE_URI = SQLite database URI.
#     Default: sqlite:///crimesense.db
#     Example absolute: sqlite:////absolute/path/to/crimesense.db
#
# Server:
#   PORT=5000
#   HOST=127.0.0.1
#   FLASK_DEBUG=1
#
# CORS:
#   CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# ============================================================

SQLALCHEMY_DATABASE_URI=sqlite:///crimesense.db

# Optional overrides
# PORT=5000
# HOST=127.0.0.1
# FLASK_DEBUG=1
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173
