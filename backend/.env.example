# ============================================================
# CrimeSense backend environment variables (template)
#
# Copy this file to backend/.env and fill in your values.
# backend/.env is git-ignored and must NEVER be committed.
#
# Supabase: Dashboard -> Project Settings -> API
#   SUPABASE_URL  = "Project URL"
#   SUPABASE_KEY  = use the "anon public" key for development.
#                   The service_role key also works but must
#                   never be exposed to the frontend.
#
# If SUPABASE_URL / SUPABASE_KEY are empty, the backend runs
# against a local SQLite fallback database (development only).
# ============================================================

SUPABASE_URL=
SUPABASE_KEY=

# Optional overrides
# PORT=5000
# HOST=127.0.0.1
# FLASK_DEBUG=1
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173