# Application
APP_NAME=CrimeAnalysis
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-this-to-a-random-secret-key

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/crime_analysis
DB_HOST=localhost
DB_PORT=5432
DB_NAME=crime_analysis
DB_USER=postgres
DB_PASSWORD=change-this-password

# API Keys
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
OPENWEATHER_API_KEY=your-openweather-api-key
POLICE_DATA_API_KEY=your-police-data-api-key

# ML Model
MODEL_PATH=ml/models/crime_hotspot_model.pkl
MODEL_THRESHOLD=0.7

# IoT / MQTT
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=crime/proximity/alerts
GPS_UPDATE_INTERVAL=30

# GIS
DEFAULT_LATITUDE=12.9165
DEFAULT_LONGITUDE=79.1325
DEFAULT_ZOOM=12
RADIUS_KM=5

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Dashboard
DASHBOARD_PORT=8501
DASHBOARD_THEME=dark