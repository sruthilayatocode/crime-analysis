# ==============================================================================
# CrimeSense - Environment Configuration Example
# Copy this file to `.env` in the backend directory and configure values.
# ==============================================================================

# Application & Security Settings
FLASK_ENV=development
DEBUG=True
SECRET_KEY=change_this_to_a_long_cryptographically_secure_random_key_in_production
JWT_SECRET_KEY=change_this_to_another_long_secure_random_jwt_key
PORT=5000

# Database Configuration (SQLite default; PostgreSQL/MySQL supported)
DATABASE_URL=sqlite:///crimesense.db

# CORS Allowed Origins (Comma-separated list of trusted frontend origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://yourdomain.com

# Admin Default Seed Credentials
# Automatically created on initial database boot if no admin exists
ADMIN_EMAIL=admin@crimesense.org
ADMIN_PASSWORD=AdminSecurePass2026!
ADMIN_NAME=System Administrator

# Google OAuth 2.0 Credentials (For Google One-Tap & Sign-In)
GOOGLE_CLIENT_ID=your_actual_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Twilio SMS / WhatsApp Emergency Dispatch Settings
# Set NOTIFICATION_PROVIDER to 'twilio' in production or 'mock' for local dev logging
NOTIFICATION_PROVIDER=mock
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Web Push Notification Keys (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key_base64
VAPID_PRIVATE_KEY=your_vapid_private_key_base64
VAPID_CLAIM_EMAIL=mailto:support@crimesense.org

# Red Zone Inactivity Monitor Settings
DEFAULT_INACTIVITY_MINUTES=10
AUTO_SOS_COOLDOWN_MINUTES=30
